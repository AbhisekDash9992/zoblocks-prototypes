{
  "name": "zoblocks-prototypes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006 --no-open --disable-telemetry",
    "build-storybook": "storybook build --output-dir storybook-static --disable-telemetry",
    "typecheck-storybook": "tsc --project tsconfig.storybook.json --noEmit",
    "build-pages": "npm run build && npm run build-storybook && node scripts/assemble-pages.mjs",
    "check-pages": "node scripts/pages-artifact.browser.mjs --static-only",
    "qa-pages": "node scripts/pages-artifact.browser.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.52.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "storybook": "10.6.2",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
